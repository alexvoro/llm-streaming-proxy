# Server
LISTEN_ADDR=:8080
STRATEGY=race  # "race" or "fallback"

# Mock providers (enabled by default for zero-config demo)
USE_MOCK_PROVIDERS=true
MOCK_A_LATENCY=20ms
MOCK_A_TOKEN_DELAY=30ms
MOCK_B_LATENCY=80ms
MOCK_B_TOKEN_DELAY=25ms

# OpenAI (set USE_MOCK_PROVIDERS=false to use real providers)
OPENAI_ENDPOINT=https://api.openai.com
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_ENDPOINT=https://api.anthropic.com
ANTHROPIC_API_KEY=

# Ollama (local)
OLLAMA_ENDPOINT=http://localhost:11434

# Timeouts
REQUEST_TIMEOUT=30s
UPSTREAM_TIMEOUT=25s
SHUTDOWN_TIMEOUT=5s
